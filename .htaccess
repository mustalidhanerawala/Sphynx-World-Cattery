Options -Indexes

# -------------------------------------------------------
# Block access to sensitive files
# -------------------------------------------------------
<FilesMatch "^(imp\.txt|Contract\.pdf)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block .git directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git(/.*)?$ - [F,L]
</IfModule>

# -------------------------------------------------------
# Canonical URL Enforcement
# -------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 2. Force non-www  (www.sphynxworldcattery.com -> sphynxworldcattery.com)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

</IfModule>

# -------------------------------------------------------
# Custom 404
# -------------------------------------------------------
# ErrorDocument 404 /404.html
